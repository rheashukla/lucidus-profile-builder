# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# Local Postgres via `docker compose up -d`, or a Neon URL
DATABASE_URL=postgres://pb:pb@localhost:5432/portfolio_builder
# Leave unset in dev: magic links print to the server console
RESEND_API_KEY=
EMAIL_FROM="Lucidus <hello@yourdomain>"
SESSION_SECRET=change-me
# Used in magic links
APP_URL=http://localhost:5173
MODEL_BRIEF=claude-sonnet-4-5
MODEL_FAST=claude-haiku-4-5
PORT=3001

# File storage: "local" (./uploads, dev) or "s3" (prod)
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=
# For S3-compatible providers (R2, MinIO, ...)
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
